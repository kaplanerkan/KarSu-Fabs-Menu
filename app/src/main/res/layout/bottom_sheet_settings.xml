<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FABsMenu Settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- KarSuFabsMenuLayout Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FABsMenuLayout"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?colorPrimary"
                    android:layout_marginBottom="12dp" />

                <!-- Overlay Color -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Overlay Color"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seekOverlayAlpha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="255"
                    android:progress="77" />

                <!-- Clickable Overlay -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchClickableOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clickable Overlay"
                    android:checked="true"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KarSuFabsMenu Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FABsMenu"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?colorPrimary"
                    android:layout_marginBottom="12dp" />

                <!-- Expand Direction -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Expand Direction"
                    android:textSize="14sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupExpandDirection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipUp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Up"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Down"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Left"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Right"
                        style="@style/Widget.Material3.Chip.Filter" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Labels Position -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Labels Position"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupLabelsPosition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLabelsLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Left"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLabelsRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Right"
                        style="@style/Widget.Material3.Chip.Filter" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Menu Button Size -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Menu Button Size"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMenuSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSizeNormal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSizeMini"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mini"
                        style="@style/Widget.Material3.Chip.Filter" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Menu Margins -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Menu Margins"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/seekMenuMargins"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="64"
                    android:progress="16" />

                <TextView
                    android:id="@+id/txtMenuMargins"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="16dp"
                    android:textSize="12sp"
                    android:gravity="end" />

                <!-- Animation Duration -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Animation Duration"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/seekAnimationDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progress="500" />

                <TextView
                    android:id="@+id/txtAnimationDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="500ms"
                    android:textSize="12sp"
                    android:gravity="end" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KarsuTitleFab Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TitleFAB (Labels)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?colorPrimary"
                    android:layout_marginBottom="12dp" />

                <!-- Label Background Color -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Label Background"
                    android:textSize="14sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupLabelBg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLabelBgWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="White"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLabelBgBlack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Black"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLabelBgPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Primary"
                        style="@style/Widget.Material3.Chip.Filter" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Label Text Color -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Label Text Color"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupLabelText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLabelTextBlack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Black"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLabelTextWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="White"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLabelTextPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Primary"
                        style="@style/Widget.Material3.Chip.Filter" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Corner Radius -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Label Corner Radius"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/seekCornerRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="24"
                    android:progress="4" />

                <TextView
                    android:id="@+id/txtCornerRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4dp"
                    android:textSize="12sp"
                    android:gravity="end" />

                <!-- Text Padding -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Label Text Padding"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/seekTextPadding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="24"
                    android:progress="8" />

                <TextView
                    android:id="@+id/txtTextPadding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="8dp"
                    android:textSize="12sp"
                    android:gravity="end" />

                <!-- Enable Title Click -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTitleClick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Label Click"
                    android:checked="true"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reset Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset to Defaults"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
